# Tidak perlu diisi manual: jalankan npm start lalu buka http://<ip-server>:3000 (halaman Instalasi menulis .env).
# Contoh isi .env bila ingin diisi manual:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db-hybrid-parking
DB_USER=hybrid
DB_PASSWORD=
PORT=3000
# Teks acak panjang (mis. hasil: openssl rand -hex 32). Jangan diubah setelah dipakai.
USER_ID_SECRET=
# Opsional: alamat publik dashboard, mis. https://parkir.domain-client.com
SITE_URL=
